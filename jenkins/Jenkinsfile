        stage('Docker Run') {
            steps {
                sh 'docker rm -f student-cicd-container || true'
                sh 'docker run --name student-cicd-container student-cicd-app:1.0'
                sh '''
                    STATUS=$(docker inspect -f '{{.State.ExitCode}}' student-cicd-container)
                    if [ "$STATUS" -ne 0 ]; then
                        echo "Docker container failed with exit code $STATUS"
                        exit 1
                    fi
                    echo "Docker container completed successfully"
                '''
            }
        }
